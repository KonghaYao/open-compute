{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [],
    "noEmit": true
  },
  "include": [
    "src/worker.ts",
    "functions/**/*.ts",
    ".cloudflare/types/index.d.ts"
  ]
}
