{
  "name": "@open-compute/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run check:docs && bun run typecheck && astro build && vite build --mode production",
    "check:docs": "bun ../../scripts/check-docs.ts",
    "deploy": "bun run build && cf deploy --prebuilt --mode production",
    "dev": "astro dev --host 127.0.0.1 --port 4173 --force",
    "preview": "bun run build && cf dev",
    "typecheck": "cf workers types --mode production && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.worker.json"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@astrojs/react": "catalog:",
    "@astrojs/starlight": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@docsearch/css": "5.1.0",
    "@docsearch/js": "5.1.0",
    "@iconify-json/tabler": "1.2.38",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@unocss/astro": "66.10.2",
    "astro": "catalog:",
    "cf": "catalog:",
    "cookie": "2.0.1",
    "satteri": "0.10.5",
    "starlight-links-validator": "0.26.0",
    "starlight-plugin-icons": "1.1.6",
    "starlight-sidebar-topics": "0.9.0",
    "starlight-theme-black": "0.7.1",
    "typescript": "catalog:",
    "unocss": "66.10.2",
    "vfile": "6.0.3",
    "vite": "catalog:"
  }
}
